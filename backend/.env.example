# Choose gemini, openrouter or groq. Keys stay on the server.
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional project IDs by key slot; keys in one project share provider quota.
GEMINI_KEY_PROJECTS={}
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=medium
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Set false for an analysis-only public deployment.
GENERATION_ENABLED=true
