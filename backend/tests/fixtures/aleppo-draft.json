{
  "title": "هَوَى حَلَبٍ الْمَكْتُومُ",
  "verses": [
    {
      "sadr": "أُخْفِي الْهَوَى فِي فُؤَادِي وَالْأَسَى عَرِمُ",
      "ajuz": "وَالسِّرُّ يَكْتُمُهُ قَلْبِي وَيَكْتَتِمُ"
    },
    {
      "sadr": "يَا ظَبْيَةً مِنْ حَلَبٍ قَدْ شَاقَنِي أَرَجٌ",
      "ajuz": "يَسْرِي بِرُوحِي وَشَوْقِي فِيَّ يَضْطَرِمُ"
    },
    {
      "sadr": "أَرْنُو إِلَيْكِ وَصَمْتِي شَاهِدٌ أَبَدًا",
      "ajuz": "وَالْوَجْدُ فِي خَاطِرِي صَمْتًا سَيَرْتَسِمُ"
    },
    {
      "sadr": "سَأَكْتُمُ الشَّوْقَ كَيْ لاَ يَسْتَبِينَ هَوًى",
      "ajuz": "حَتَّى يُقَالَ: جَوَى الْعُشَّاقِ يَحْتَدِمُ"
    }
  ]
}
