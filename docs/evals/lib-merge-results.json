[
  {
    "id": "imru-alqais",
    "preserve": false,
    "valid": 0,
    "rawi": 2,
    "verses": [
      {
        "sadr": "قَفَا نَبْكٌ مِنْ ذِكْرَى حَبِيبٍ وَمَنْزِل",
        "ajuz": "بِسَقْطِ اللَّوَى بَيْنَ الدُّخُولِ فَحُومَل"
      },
      {
        "sadr": "فَتُوضِّحُ فَالْمِقْرَاةُ لَمْ يَعُفْ رَسْمُهَا",
        "ajuz": "لِمَا نَسَجْتُهَا مِنْ جَنُوبٍ وَشَمْأَل"
      }
    ]
  },
  {
    "id": "mutanabbi-azm",
    "preserve": false,
    "valid": 0,
    "rawi": 2,
    "verses": [
      {
        "sadr": "عَلَى قَدْرِ أَهْلِ الْعَزْمِ تَأْتِي الْعَزَائِم",
        "ajuz": "وَتَأْتِي عَلَى قَدْرِ الْكَرَامِ الْمُكَارِم"
      },
      {
        "sadr": "وَتُعَظَّمُ فِي عَيْنِ الصَّغِيرِ صِغَارَهَا",
        "ajuz": "وَتَصَغَّرَ فِي عَيْنِ الْعَظِيمِ الْعَظَائِم"
      }
    ]
  },
  {
    "id": "shabbi",
    "preserve": false,
    "valid": 1,
    "rawi": 2,
    "verses": [
      {
        "sadr": "إِذَا الشَّعْبُ يَوْمًا أَرَادَ الْحَيَاة",
        "ajuz": "فَلَا بُدَّ أَنْ يَسْتَجِيبَ الْقَدْر"
      },
      {
        "sadr": "وَلَا بُدَّ لِلْيَلِ أَنْ يَنْجُلِي",
        "ajuz": "وَلَا بُدَّ لِلْقَيْدِ أَنْ يَنْكَسِر"
      }
    ]
  },
  {
    "id": "mutanabbi-sharaf",
    "preserve": false,
    "valid": 0,
    "rawi": 2,
    "verses": [
      {
        "sadr": "إِذَا غَامَرْتْ فِي شُرْفِ مُرُوم",
        "ajuz": "فَلا تَقْنَعُ بِمَا دُونَ النُّجُوم"
      },
      {
        "sadr": "فَطَعِمَ الْمَوْتَ فِي أَمْرٍ صَغِير",
        "ajuz": "كَطَعْمِ الْمَوْتِ فِي أَمْرٍ عَظِيم"
      }
    ]
  },
  {
    "id": "abu-tammam",
    "preserve": false,
    "valid": 1,
    "rawi": 2,
    "verses": [
      {
        "sadr": "السَّيْفُ أَصْدَقَ أَنْباءٌ مِنَ الْكُتُب",
        "ajuz": "فِي حَدِّهِ الْحَدْ بَيْنَ الْجَدِّ وَاللَّعِب"
      },
      {
        "sadr": "بَيْضِ الصَّفَائِحِ لَا سُودَ الصَّحَائِفُ فِي",
        "ajuz": "مُتَونُهُنَّ جَلَاءَ الشَّكِّ وَالرِّيب"
      }
    ]
  },
  {
    "id": "antara",
    "preserve": false,
    "valid": 0,
    "rawi": 2,
    "verses": [
      {
        "sadr": "هَلْ غَادِرُ الشُّعَرَاءِ مِنْ مُتَرَدِّم",
        "ajuz": "أَمْ هَلْ عَرِفْتِ الدَّارَ بَعْدَ تَوَهُّم"
      },
      {
        "sadr": "يَا دَارَ عِبْلَةٍ بِالْجَوَاءِ تَكَلُّمِي",
        "ajuz": "وَعَمِّيَ صَباحًا دَارَ عِبْلَةِ وَاسْلِمِي"
      }
    ]
  },
